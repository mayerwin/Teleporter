<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org, so a user-level private feed can never break or leak into the build. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
